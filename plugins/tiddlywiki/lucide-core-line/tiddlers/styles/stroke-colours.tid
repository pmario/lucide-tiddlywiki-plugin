title: $:/plugins/tiddlywiki/lucide-core-line/styles/stroke-colours
tags: $:/tags/Stylesheet

\rules only filteredtranscludeinline transcludeinline macrodef macrocallinline macrocallblock

svg[stroke="currentColor"] { stroke: inherit; }

html button { stroke: <<colour button-foreground>>; }

button:disabled svg { stroke: <<colour muted-foreground>>; }

body.tc-body { stroke: <<colour foreground>>; }

.tc-sidebar-tab-open .tc-btn-invisible.tc-btn-mini svg { stroke: <<colour muted-foreground>>; }

.tc-btn-invisible { stroke: <<colour foreground>>; }

html body.tc-body .tc-btn-boxed:hover svg { stroke: <<colour background>>; }

html body.tc-body .tc-btn-rounded svg { stroke: <<colour background>>; }

html body.tc-body .tc-btn-rounded:hover svg { stroke: <<colour muted-foreground>>; }

.tc-btn-icon svg { stroke: <<colour muted-foreground>>; }

.tc-btn-big-green { stroke: <<colour download-foreground>>; }

.tc-btn-big-green svg,
.tc-btn-big-green img { stroke: <<colour download-foreground>>; }

.tc-sidebar-lists button { stroke: <<colour sidebar-button-foreground>>; }

.tc-unfold-banner svg,
.tc-fold-banner svg { stroke: <<colour tiddler-controls-foreground>>; }

.tc-unfold-banner:hover svg,
.tc-fold-banner:hover svg { stroke: <<colour tiddler-controls-foreground-hover>>; }

.tc-topbar svg { stroke: <<colour muted-foreground>>; }

.tc-topbar button:hover svg { stroke: <<colour foreground>>; }

.tc-sidebar-header { stroke: <<colour sidebar-foreground>>; }

.tc-page-controls svg { stroke: <<colour sidebar-controls-foreground>>; }

.tc-page-controls button:hover svg,
.tc-page-controls a:hover svg { stroke: <<colour sidebar-controls-foreground-hover>>; }

.tc-tiddler-controls button svg,
.tc-tiddler-controls button img,
.tc-search button svg,
.tc-search a svg { stroke: <<colour tiddler-controls-foreground>>; }

.tc-tiddler-controls button.tc-selected svg,
.tc-page-controls button.tc-selected svg { stroke: <<colour tiddler-controls-foreground-selected>>; }

.tc-tiddler-controls button.tc-btn-invisible:hover svg,
.tc-search button:hover svg,
.tc-search a:hover svg { stroke: <<colour tiddler-controls-foreground-hover>>; }

.tc-editor-toolbar button { stroke: <<colour tiddler-controls-foreground-selected>>; }

.tc-editor-toolbar button:hover { stroke: <<colour background>>; }

.tc-page-controls svg.tc-image-new-button { stroke: <<colour toolbar-new-button>>; }

.tc-page-controls svg.tc-image-options-button { stroke: <<colour toolbar-options-button>>; }

.tc-page-controls svg.tc-image-save-button { stroke: <<colour toolbar-save-button>>; }

.tc-tiddler-controls button svg.tc-image-info-button { stroke: <<colour toolbar-info-button>>; }

.tc-tiddler-controls button svg.tc-image-edit-button { stroke: <<colour toolbar-edit-button>>; }

.tc-tiddler-controls button svg.tc-image-close-button { stroke: <<colour toolbar-close-button>>; }

.tc-tiddler-controls button svg.tc-image-delete-button { stroke: <<colour toolbar-delete-button>>; }

.tc-tiddler-controls button svg.tc-image-cancel-button { stroke: <<colour toolbar-cancel-button>>; }

.tc-tiddler-controls button svg.tc-image-done-button { stroke: <<colour toolbar-done-button>>; }

.tc-page-controls svg.tc-image-layout-button { stroke: <<colour toolbar-options-button>>; }

.tc-edit-field-remove svg { stroke: <<colour muted-foreground>>; }

.tc-btn-dropdown svg,
.tc-btn-dropdown img { stroke: <<colour muted-foreground>>; }

.tc-drop-down button svg,
.tc-drop-down a svg { stroke: <<colour foreground>>; }

.tc-drop-down button:disabled svg { stroke: <<colour muted-foreground>>; }

.tc-drop-down button.tc-btn-invisible:hover svg { stroke: <<colour background>>; }

.tc-manager-list-item-heading-selected { stroke: <<colour background>>; }

.tc-alert-toolbar svg { stroke: <<colour alert-muted-foreground>>; }

.tc-drafts-list a { stroke: <<colour background>>; }

.tc-drafts-list a:hover { stroke: <<colour background>>; }

.tc-plugin-info { stroke: <<colour muted-foreground>>; }

a.tc-tiddlylink.tc-plugin-info:hover { stroke: <<colour foreground>>; }

a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk > svg { stroke: <<colour background>>; }

.tc-install-plugin { stroke: white; }

.tc-table-of-contents svg { stroke: <<colour sidebar-foreground>>; }

html body.tc-dirty span.tc-dirty-indicator,
html body.tc-dirty span.tc-dirty-indicator svg { stroke: <<colour dirty-indicator>>; }

.tc-thumbnail-wrapper:hover .tc-thumbnail-icon svg,
.tc-thumbnail-wrapper:hover .tc-thumbnail-icon img { stroke: #fff; }

.tc-tree svg { stroke: #acacac; }

.tc-fill-background { stroke: <<colour background>>; }

.tc-network-activity-background { stroke: <<colour network-activity-foreground>>; }

.tc-test-case-result-icon { stroke: #fff; }

.tc-test-case-toolbar svg { stroke: <<colour tiddler-controls-foreground>>; }

html body.tc-body .tc-tag-label,
html body.tc-body .tc-thumbnail-icon { stroke: currentColor; }
