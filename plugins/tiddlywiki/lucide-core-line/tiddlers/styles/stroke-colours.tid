/* Generated by scripts/build-lucide-core-line.mjs from vanilla's base.tid and TW plugin styles: DO NOT EDIT */

/* Other svgs keep their default of no stroke instead of inheriting the colours below */
svg:not([stroke]) { stroke: none; }

/* Line icons take the stroke colour of the rules below instead of their stroke attribute */
svg[stroke="currentColor"] { stroke: inherit; }

/* Vanilla colours core icons with fill: the same selectors give line icons the same colours */
html button { stroke: <<colour button-foreground>>; }

button:disabled svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

body.tc-body { stroke: <<colour foreground>>; }

.tc-sidebar-tab-open .tc-btn-invisible.tc-btn-mini svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-btn-invisible { stroke: <<colour foreground>>; }

html body.tc-body .tc-btn-boxed:hover svg[stroke="currentColor"] { stroke: <<colour background>>; }

html body.tc-body .tc-btn-rounded svg[stroke="currentColor"] { stroke: <<colour background>>; }

html body.tc-body .tc-btn-rounded:hover svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-btn-icon svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-btn-big-green { stroke: <<colour download-foreground>>; }

.tc-btn-big-green svg[stroke="currentColor"] { stroke: <<colour download-foreground>>; }

.tc-sidebar-lists button { stroke: <<colour sidebar-button-foreground>>; }

.tc-unfold-banner svg[stroke="currentColor"],
.tc-fold-banner svg[stroke="currentColor"] { stroke: <<colour tiddler-controls-foreground>>; }

.tc-unfold-banner:hover svg[stroke="currentColor"],
.tc-fold-banner:hover svg[stroke="currentColor"] { stroke: <<colour tiddler-controls-foreground-hover>>; }

.tc-topbar svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-topbar button:hover svg[stroke="currentColor"] { stroke: <<colour foreground>>; }

.tc-sidebar-header { stroke: <<colour sidebar-foreground>>; }

.tc-page-controls svg[stroke="currentColor"] { stroke: <<colour sidebar-controls-foreground>>; }

.tc-page-controls button:hover svg[stroke="currentColor"],
.tc-page-controls a:hover svg[stroke="currentColor"] { stroke: <<colour sidebar-controls-foreground-hover>>; }

.tc-tiddler-controls button svg[stroke="currentColor"],
.tc-search button svg[stroke="currentColor"],
.tc-search a svg[stroke="currentColor"] { stroke: <<colour tiddler-controls-foreground>>; }

.tc-tiddler-controls button.tc-selected svg[stroke="currentColor"],
.tc-page-controls button.tc-selected svg[stroke="currentColor"] { stroke: <<colour tiddler-controls-foreground-selected>>; }

.tc-tiddler-controls button.tc-btn-invisible:hover svg[stroke="currentColor"],
.tc-search button:hover svg[stroke="currentColor"],
.tc-search a:hover svg[stroke="currentColor"] { stroke: <<colour tiddler-controls-foreground-hover>>; }

.tc-editor-toolbar button { stroke: <<colour tiddler-controls-foreground-selected>>; }

.tc-editor-toolbar button:hover { stroke: <<colour background>>; }

.tc-page-controls svg.tc-image-new-button[stroke="currentColor"] { stroke: <<colour toolbar-new-button>>; }

.tc-page-controls svg.tc-image-options-button[stroke="currentColor"] { stroke: <<colour toolbar-options-button>>; }

.tc-page-controls svg.tc-image-save-button[stroke="currentColor"] { stroke: <<colour toolbar-save-button>>; }

.tc-tiddler-controls button svg.tc-image-info-button[stroke="currentColor"] { stroke: <<colour toolbar-info-button>>; }

.tc-tiddler-controls button svg.tc-image-edit-button[stroke="currentColor"] { stroke: <<colour toolbar-edit-button>>; }

.tc-tiddler-controls button svg.tc-image-close-button[stroke="currentColor"] { stroke: <<colour toolbar-close-button>>; }

.tc-tiddler-controls button svg.tc-image-delete-button[stroke="currentColor"] { stroke: <<colour toolbar-delete-button>>; }

.tc-tiddler-controls button svg.tc-image-cancel-button[stroke="currentColor"] { stroke: <<colour toolbar-cancel-button>>; }

.tc-tiddler-controls button svg.tc-image-done-button[stroke="currentColor"] { stroke: <<colour toolbar-done-button>>; }

.tc-page-controls svg.tc-image-layout-button[stroke="currentColor"] { stroke: <<colour toolbar-options-button>>; }

.tc-edit-field-remove svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-btn-dropdown svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-drop-down button svg[stroke="currentColor"],
.tc-drop-down a svg[stroke="currentColor"] { stroke: <<colour foreground>>; }

.tc-drop-down button:disabled svg[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-drop-down button.tc-btn-invisible:hover svg[stroke="currentColor"] { stroke: <<colour background>>; }

.tc-manager-list-item-heading-selected { stroke: <<colour background>>; }

.tc-alert-toolbar svg[stroke="currentColor"] { stroke: <<colour alert-muted-foreground>>; }

.tc-drafts-list a { stroke: <<colour background>>; }

.tc-drafts-list a:hover { stroke: <<colour background>>; }

.tc-plugin-info { stroke: <<colour muted-foreground>>; }

a.tc-tiddlylink.tc-plugin-info:hover { stroke: <<colour foreground>>; }

a.tc-tiddlylink.tc-plugin-info:hover > .tc-plugin-info-chunk > svg[stroke="currentColor"] { stroke: <<colour background>>; }

.tc-install-plugin { stroke: white; }

.tc-table-of-contents svg[stroke="currentColor"] { stroke: <<colour sidebar-foreground>>; }

html body.tc-dirty span.tc-dirty-indicator,
html body.tc-dirty span.tc-dirty-indicator svg[stroke="currentColor"] { stroke: <<colour dirty-indicator>>; }

.tc-thumbnail-wrapper:hover .tc-thumbnail-icon svg[stroke="currentColor"] { stroke: #fff; }

.tc-tree svg[stroke="currentColor"] { stroke: #acacac; }

.tc-fill-background { stroke: <<colour background>>; }

.tc-network-activity-background { stroke: <<colour network-activity-foreground>>; }

.tc-test-case-result-icon { stroke: #fff; }

.tc-test-case-toolbar svg[stroke="currentColor"] { stroke: <<colour tiddler-controls-foreground>>; }

/* The text-slicer plugin colours its icons with fill */
.tc-view-template-document-tiddler-heading-icon svg[stroke="currentColor"],
.tc-edit-template-document-tiddler-heading-icon svg[stroke="currentColor"] { stroke: <<colour background>>; }

/* The upgrade plugin colours its icons with fill */
.tc-upgrade-wizard svg.tc-image-download-button[stroke="currentColor"] { stroke: <<colour muted-foreground>>; }

.tc-upgrade-wizard:hover svg.tc-image-download-button[stroke="currentColor"] { stroke: <<colour foreground>>; }

.tc-upgrade-wizard:hover svg[stroke="currentColor"] .tc-image-download-button-ring { stroke: <<colour primary>>; }

/* Tag pills and thumbnails colour icons with an inline fill and the same inline color */
html body.tc-body .tc-tag-label,
html body.tc-body .tc-thumbnail-icon { stroke: currentColor; }

/* The remove-tag button has the inline fill of its tag but the color of .tc-btn-invisible, and currentColor inherits as a keyword */
html body.tc-body .tc-tag-label .tc-remove-tag-button { color: inherit; stroke: inherit; }
