/* Generated by scripts/build-lucide-core-line.mjs from $:/plugins/tiddlywiki/menubar/styles: DO NOT EDIT */

/* The menubar plugin colours its icons with fill while it is installed */
<%if [[$:/plugins/tiddlywiki/menubar/styles]is[shadow]] %>

nav.tc-menubar li.tc-menubar-item > a,
nav.tc-menubar li.tc-menubar-item > button { stroke: <<colour foreground>>; stroke: <<colour menubar-foreground>>; }

nav.tc-menubar li.tc-menubar-item > a.tc-selected,
nav.tc-menubar li.tc-menubar-item > button.tc-selected { stroke: <<colour background>>; stroke: <<colour menubar-background>>; }

nav.tc-menubar li.tc-menubar-item svg[stroke="currentColor"] { stroke: <<colour foreground>>; stroke: <<colour menubar-foreground>>; }

nav.tc-menubar li.tc-menubar-item > a.tc-selected svg[stroke="currentColor"],
nav.tc-menubar li.tc-menubar-item > button.tc-selected svg[stroke="currentColor"] { stroke: <<colour background>>; stroke: <<colour menubar-background>>; }

nav.tc-menubar li.tc-menubar-item > a:hover,
nav.tc-menubar li.tc-menubar-item > button:hover svg[stroke="currentColor"],
nav.tc-menubar li.tc-menubar-item > button:hover { stroke: <<colour background>>; stroke: <<colour menubar-background>>; }

nav.tc-menubar li.tc-menubar-item > a:active,
nav.tc-menubar li.tc-menubar-item > button:active svg[stroke="currentColor"],
nav.tc-menubar li.tc-menubar-item > button:active { stroke: <<colour background>>; stroke: <<colour menubar-background>>; }

<%endif%>
