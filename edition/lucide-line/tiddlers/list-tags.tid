\import [[Lucide Gallery]] [[_:/plugins/wikilabs/bundler/ui/sidbar/icon-set]]

\procedure eventActions()
<$let imageTitle=<<dom-title>>>
	<<copyActions>>
</$let>
\end

Search tags: <$edit-text tag="input" tiddler="$:/temp/volatile/search/tag" class="lucide-tag-search"/><%if [{$:/temp/volatile/search/tag}!match[]] %><$button class="tc-btn-invisible tc-small-gap-left" set="$:/temp/volatile/search/tag" setTo="" tooltip="Clear search">{{$:/core/images/close-button}}</$button><%endif%>
<%if [{$:/state/lucide/tags/expand-all}match[yes]] %>
<$button set="$:/state/lucide/tags/expand-all" setTo="no" class="tc-small-gap-left">Collapse All</$button>
<%else%>
<$button set="$:/state/lucide/tags/expand-all" setTo="yes" class="tc-small-gap-left">Expand All</$button>
<%endif%>

<<lab-checkbox>>

<!-- Rendering the icons of every tag is slow, so they show only for Expand All or a search of 2 or more characters, spaces included -->
<$let expanded={{{ [{$:/temp/volatile/search/tag}length[]compare:number:gteq[2]] [{$:/state/lucide/tags/expand-all}match[yes]] +[then[yes]] }}}>
<$eventcatcher selector=".image-wrapper" $click=<<eventActions>> tag="div" class="flexbox">
<!-- Expanded tags are the literal tags plus the group tags, so the tag names need no expansion -->
<$list filter="[has[lucide]] :filter[f.visible[]] :and[tags[]] [all[tiddlers]prefix[g:]tags[]] +[!prefix[e:]!prefix[g:]unique[]] :filter[search:title{$:/temp/volatile/search/tag}] +[sort[]]" emptyMessage="No such tag">
<div class="col">
<$macrocall $name="tag-pill" tag=<<currentTiddler>> element-tag="$button" actions="""<$action-setfield $tiddler="$:/temp/volatile/search/tag" text=<<currentTiddler>>/><$action-sendmessage $message="tm-scroll" selector=".lucide-tag-search"/>"""/>
<%if [<expanded>match[yes]] %>
<hr>
<div class="tc-image-chooser">
<$macrocall $name="image-picker-list"
	filter="[lucide.tagged<currentTiddler>sort[title]] :filter[f.visible[]] :map[<f.makeLink>]"/>
</div>
<%endif%>
</div>
</$list>
</$eventcatcher>
</$let>


