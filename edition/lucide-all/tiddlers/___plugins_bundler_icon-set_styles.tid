.multi-columns {
	display: block;
	column-count: 6;
	column-gap: 1em;
	-moz-column-count: 6;
	-moz-column-gap: 1em;
	-webkit-column-count: 6;
	-webkit-column-gap: 1em;
}

.multi-columns ol {
	margin: initial;
}

.tc-image-chooser .image-wrapper {
	display: inline-block;
	vertical-align: top;
	text-align: center;
	position: relative;
	border: 1px solid <<colour muted-foreground>>;
	padding: 2px;
	margin: 2px;
	width: 4em;
	height: 4em;
}

.tc-image-chooser .image-wrapper:hover {
	background: <<colour primary>>;
	padding: 0px;
	border: 3px solid <<colour primary>>;
}

/* Lucide Lab marker: a red diamond, like on lucide.dev */
.lucide-lab-marker,
.tc-image-chooser .image-wrapper.lucide-lab::after {
	width: 6px;
	height: 6px;
	background: #ef4444;
	transform: rotate(45deg);
}

.lucide-lab-marker {
	display: inline-block;
	vertical-align: middle;
	margin-left: 0.3em;
}

.tc-image-chooser .image-wrapper.lucide-lab::after {
	content: "";
	position: absolute;
	top: 4px;
	right: 4px;
}

.tc-image-chooser .image-wrapper svg,
.tc-image-chooser .image-wrapper img {
	display: inline-block;
	width: auto;
	height: auto;
	max-width: 3.5em;
	max-height: 3.5em;
	position: absolute;
	top: 0;
	bottom: 0;
	left: 0;
	right: 0;
	margin: auto;
}

.category.row {
	margin-bottom: 1.5em;
}

/* Tags view: 3 columns */
.flexbox {
	display: flex;
	flex-flow: row wrap;
	overflow: hidden;
}

.flexbox .col {
	flex: 1 1 33%;
	margin-bottom: 1em;
}
