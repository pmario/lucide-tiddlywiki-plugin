{
	"description": "Lucide All Icons",
	"plugins": [
		"tiddlywiki/browser-storage",
		"tiddlywiki/lucide-core",
		"tiddlywiki/lucide-all",
		"lucideicons/template",
		"wikilabs/bundler",
		"wikilabs/link-to-tabs",
		"wikilabs/new-style"
	],
	"themes": [
		"tiddlywiki/vanilla",
		"tiddlywiki/snowwhite",
		"tiddlywiki/readonly",
		"wikilabs/underlinedtabs"
	],
	"languages": [
	],
	"build": {
		"lucide-all": [
			"--render","$:/core/save/all","lucide-all.html","text/plain","",
			"publishFilter","-[prefix[$:/plugins/lucideicons/]!prefix[$:/plugins/lucideicons/template]] -[prefix[_:/config/icon-set/]!match[_:/config/icon-set/itemTemplate]] -[[$:/Import]] -[[import.bundle]] -[[$:/plugins/wikilabs/info-tagmap]] -[[$:/config/OriginalTiddlerPaths]]"
		],
		"favicon": [
			"--savetiddler","$:/favicon.ico","favicon.ico",
			"--savetiddler","$:/green_favicon.ico","static/favicon.ico"
		],
		"static": [
			"--render","$:/core/templates/static.template.html","static.html","text/plain",
			"--render","$:/core/templates/alltiddlers.template.html","alltiddlers.html","text/plain",
			"--render","[!is[system]]","[encodeuricomponent[]addprefix[static/]addsuffix[.html]]","text/plain","$:/core/templates/static.tiddler.html",
			"--render","$:/core/templates/static.template.css","static/static.css","text/plain"]
	},
	"config": {
		"retain-original-tiddler-path": true
	}
}
